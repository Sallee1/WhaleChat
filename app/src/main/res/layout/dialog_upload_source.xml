<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/upload_source_title"
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_upload_sheet"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/btn_camera"
            style="@style/UploadTile">

            <ImageView
                style="@style/UploadTileIcon"
                android:contentDescription="@string/take_photo"
                android:src="@drawable/ic_camera" />

            <TextView
                style="@style/UploadTileText"
                android:text="@string/take_photo" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_album"
            style="@style/UploadTile">

            <ImageView
                style="@style/UploadTileIcon"
                android:contentDescription="@string/choose_from_album"
                android:src="@drawable/ic_album" />

            <TextView
                style="@style/UploadTileText"
                android:text="@string/choose_from_album" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_file"
            style="@style/UploadTile">

            <ImageView
                style="@style/UploadTileIcon"
                android:contentDescription="@string/choose_file"
                android:src="@drawable/ic_file" />

            <TextView
                style="@style/UploadTileText"
                android:text="@string/choose_file" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
